# Mẫu cấu hình Spring Boot trên máy phát triển.
# Nhập các biến vào môi trường Terminal hoặc IntelliJ Run Configuration.
# Điền thông tin kết nối và bí mật trong môi trường riêng trước khi chạy.
SERVER_PORT=8080
DB_URL=jdbc:mysql://127.0.0.1:3306/teasmart
DB_USERNAME=
DB_PASSWORD=
JWT_ISSUER=teasmart-local
JWT_SECRET_BASE64=

GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_SECRET=
GOOGLE_LINK_REDIRECT_URI=

MAIL_ENABLED=false
MAIL_FROM=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
PASSWORD_RESET_ENABLED=false
FRONTEND_BASE_URL=http://localhost:3000

VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return

REVIEW_AI_BASE_URL=http://127.0.0.1:8000
RAG_ENABLED=false
RAG_SERVICE_URL=http://127.0.0.1:8002
LEAF_AI_BASE_URL=http://127.0.0.1:8003
